# Spark inference code refresh on the separately verified dependency runtime.
# No package upgrades, model artifacts, data, .env or MLflow store are copied.
ARG WORKER_RUNTIME_IMAGE=nyc-taxi-worker:p6-clean
FROM ${WORKER_RUNTIME_IMAGE}

WORKDIR /app
COPY requirements.txt requirements-worker-constraints.txt pyproject.toml /tmp/inference-inputs/
RUN python -B -c "from pathlib import Path; names=('requirements.txt','requirements-worker-constraints.txt','pyproject.toml'); assert all((Path('/app')/n).read_bytes()==(Path('/tmp/inference-inputs')/n).read_bytes() for n in names), 'Dependency inputs changed; review a full build separately'" \
    && python -m pip check \
    && groupadd --gid 10001 inference \
    && useradd --uid 10001 --gid 10001 --home-dir /tmp --no-create-home --shell /usr/sbin/nologin inference

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY config/config.yaml ./config/config.yaml
COPY config/pretrip_v2_contract.json config/pretrip_v2_calendar.json config/model_bundle_v22.lock.json ./config/
COPY Dockerfile.inference docker-compose.inference.yml docker-compose.pretrip-v22.yml ./

ENV HOME=/tmp \
    USER=inference \
    LOGNAME=inference \
    PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=90s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=3)"]
CMD ["python", "-m", "nyc_taxi.ml.inference_server", "--model-dir", "/model", "--contract-dir", "/model-contract", "--zones", "/model-contract/zones.csv", "--host", "0.0.0.0", "--port", "8000"]
