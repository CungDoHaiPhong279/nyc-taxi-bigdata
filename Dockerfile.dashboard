FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /app
COPY requirements-dashboard.txt ./
RUN python -m pip install --no-cache-dir -r requirements-dashboard.txt

# Copy only the web entry point and the existing config/database helpers it uses.
COPY src/nyc_taxi/__init__.py ./src/nyc_taxi/__init__.py
COPY src/nyc_taxi/common/__init__.py src/nyc_taxi/common/config.py ./src/nyc_taxi/common/
COPY src/nyc_taxi/database/__init__.py src/nyc_taxi/database/postgres.py ./src/nyc_taxi/database/
COPY src/nyc_taxi/dashboard/ ./src/nyc_taxi/dashboard/
COPY config/config.yaml ./config/config.yaml
COPY dashboard/app.py ./dashboard/app.py

USER 10001:10001
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"]
CMD ["python", "-m", "streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--server.fileWatcherType=none", "--browser.gatherUsageStats=false"]

# Optional offline verification image; pytest/tests are absent from the web image.
FROM runtime AS test
USER root
RUN python -m pip install --no-cache-dir pytest==9.1.1
COPY tests/test_dashboard_queries.py tests/test_dashboard_app.py ./tests/
USER 10001:10001

FROM runtime AS dashboard
